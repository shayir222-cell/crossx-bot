# Real values go to Render Environment Variables, NEVER into the repo.
# This file documents the schema only.

BITGET_API_KEY=__set_in_render__
BITGET_API_SECRET=__set_in_render__
BITGET_PASSPHRASE=__set_in_render__

# WEBHOOK_TOKEN: long random string (>=32 chars). Auth on /webhook,
# /backup, /db-stats. MUST NOT be 'change_me' (rejected by _check_auth).
WEBHOOK_TOKEN=__set_in_render_long_random_string__

# Telegram bot — rotate with @BotFather if leaked.
TG_TOKEN=__set_in_render__
TG_CHAT_ID=__set_in_render__

# Persistent SQLite path. On Render: mount disk to /var/data and use that.
# Default is ./crossx.db (ephemeral on free tier — Phase B persistence breaks).
DB_PATH=/var/data/crossx.db

# Used by keep_alive() to self-ping (avoid free-tier sleep).
RENDER_URL=https://your-service.onrender.com

PORT=8080
